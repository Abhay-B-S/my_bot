{
  "rules": {
    ".read": false,
    ".write": false,

    "members": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      "$id": {
        ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'admin' && $id != 'admin' && $id != 'robot' && !data.child('role').exists()",
        ".validate": "$id.matches(/^[a-z0-9]{3,20}$/) && newData.hasChildren(['name', 'cabin'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 60" },
        "cabin": { ".validate": "newData.isString() && newData.val().matches(/^cabin_[A-Z]$/)" },
        "$other": { ".validate": false }
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'admin'",
      "title": { ".validate": "newData.isString() && newData.val().length < 90" },
      "robotName": { ".validate": "newData.isString() && newData.val().length < 40" },
      "$other": { ".validate": false }
    },

    "robot": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot'"
    },

    "pose": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot'"
    },

    "map": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot'"
    },

    "spots": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && (root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'admin' || root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot')",
      "$name": {
        ".validate": "$name.matches(/^(home|cabin_[A-Z])$/) && newData.hasChildren(['x', 'y', 'yaw'])",
        "x": { ".validate": "newData.isNumber() && newData.val() > -500 && newData.val() < 500" },
        "y": { ".validate": "newData.isNumber() && newData.val() > -500 && newData.val() < 500" },
        "yaw": { ".validate": "newData.isNumber() && newData.val() >= -7 && newData.val() <= 7" },
        "by": { ".validate": "newData.isString() && newData.val().length < 60" },
        "label": { ".validate": "newData.isString() && newData.val().length < 60" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "eta": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot'"
    },

    "battery": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot'"
    },

    "wifiMap": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot'"
    },

    "spotStatus": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot'"
    },

    "spotsMap": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot'",
      ".validate": "newData.isString() && newData.val().length < 100"
    },

    "control": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      "estop": { ".validate": "newData.isBoolean()" },
      "by": { ".validate": "newData.isString() && newData.val().length < 60" },
      "t": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": false }
    },

    "requests": {
      ".read": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).exists()",
      "$id": {
        ".write": "auth != null && (root.child('members').child(auth.token.email.replace('@example.com', '')).child('role').val() == 'robot' || (!data.exists() && newData.exists() && root.child('members').child(auth.token.email.replace('@example.com', '')).child('cabin').val() == newData.child('sender').val() && newData.child('sender').val() != newData.child('destination').val() && newData.child('status').val() == 'pending' && !newData.child('shipped').exists() && !newData.child('received').exists() && !newData.child('lidSender').exists() && !newData.child('lidReceiver').exists() && !newData.child('returned').exists() && !newData.child('lidReturn').exists() && !newData.child('cancel').exists() && (newData.child('urgent').val() != true || newData.child('reason').exists())))",

        "sender": { ".validate": "newData.isString() && newData.val().matches(/^cabin_[A-Z]$/)" },
        "destination": { ".validate": "newData.isString() && newData.val().matches(/^cabin_[A-Z]$/)" },
        "senderName": { ".validate": "newData.isString() && newData.val().length < 60" },
        "receiverName": { ".validate": "newData.isString() && newData.val().length < 60" },
        "status": { ".validate": "newData.isString() && newData.val().length < 40" },
        "detail": { ".validate": "newData.isString() && newData.val().length < 400" },
        "created": { ".validate": "newData.isNumber()" },
        "urgent": { ".validate": "newData.isBoolean()" },
        "reason": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length < 120" },
        "cancel": {
          ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('cabin').val() == data.parent().child('sender').val() && (data.parent().child('status').val() == 'pending' || data.parent().child('status').val() == 'queued' || data.parent().child('status').val() == 'going_to_sender' || data.parent().child('status').val() == 'wait_shipped' || data.parent().child('status').val() == 'going_to_destination' || data.parent().child('status').val() == 'wait_received') && newData.val() == true",
          ".validate": "newData.val() == true"
        },

        "shipped": {
          ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('cabin').val() == data.parent().child('sender').val() && data.parent().child('status').val() == 'wait_shipped' && newData.val() == true",
          ".validate": "newData.val() == true"
        },
        "received": {
          ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('cabin').val() == data.parent().child('destination').val() && data.parent().child('status').val() == 'wait_received' && newData.val() == true",
          ".validate": "newData.val() == true"
        },
        "lidSender": {
          ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('cabin').val() == data.parent().child('sender').val() && data.parent().child('status').val() == 'wait_shipped' && newData.val() == true",
          ".validate": "newData.val() == true"
        },
        "lidReceiver": {
          ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('cabin').val() == data.parent().child('destination').val() && data.parent().child('status').val() == 'wait_received' && newData.val() == true",
          ".validate": "newData.val() == true"
        },
        "returned": {
          ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('cabin').val() == data.parent().child('sender').val() && data.parent().child('status').val() == 'wait_returned' && newData.val() == true",
          ".validate": "newData.val() == true"
        },
        "lidReturn": {
          ".write": "auth != null && root.child('members').child(auth.token.email.replace('@example.com', '')).child('cabin').val() == data.parent().child('sender').val() && data.parent().child('status').val() == 'wait_returned' && newData.val() == true",
          ".validate": "newData.val() == true"
        },

        "$other": { ".validate": false }
      }
    }
  }
}
